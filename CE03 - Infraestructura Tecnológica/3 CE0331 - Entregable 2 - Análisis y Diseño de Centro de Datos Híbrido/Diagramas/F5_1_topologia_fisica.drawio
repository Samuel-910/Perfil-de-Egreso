xGeometry x="790" y="268" width="29" height="18" as="geometry"/></mxCell><mxCell id="t54" value="U5" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#7F7F7F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="238" width="29" height="18" as="geometry"/></mxCell><mxCell id="t55" value="U6" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#7F7F7F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="208" width="29" height="18" as="geometry"/></mxCell><mxCell id="t56" value="U7" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#7F7F7F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="178" width="29" height="18" as="geometry"/></mxCell><mxCell id="t57" value="U8" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#7F7F7F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="148" width="29" height="18" as="geometry"/></mxCell><mxCell id="t58" value="U9" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#7F7F7F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="118" width="29" height="18" as="geometry"/></mxCell><mxCell id="t59" value="Cableado y conexiones del host&#xa;· vmnic0/1 (1 GbE) → CORE-JUL-01/02, VLAN 70 (gestión)&#xa;· vmnic2/3 (10 GbE SFP+) → CORE-JUL-01/02, troncal VLAN 10, 20, 100&#xa;· vmnic4 (1 GbE) ← puerto SPAN del núcleo (captura del IDS)&#xa;· iDRAC → VLAN 70 (10.10.70.31) · NAS 2 × 1 GbE → VLAN 10 (10.10.10.30)&#xa;&#xa;Ambiente: split dedicado de 12 000 BTU/h frente a ≈ 2 000 BTU/h de calor;&#xa;puesta a tierra TIA-607; etiquetado TIA-606." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="427" height="121" as="geometry"/></mxCell><mxCell id="title" value="Figura 5.1 — Topología física on-premise: rack de Juliaca y gabinete de Puno" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1F4E79;fontFamily=Arial;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>