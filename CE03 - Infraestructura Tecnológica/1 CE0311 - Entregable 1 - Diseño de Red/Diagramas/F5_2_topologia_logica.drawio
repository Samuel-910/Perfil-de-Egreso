olor=#C55A11;strokeWidth=2;dashed=1;fontFamily=Arial;fontSize=10;fontColor=#C55A11;endArrow=block;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t42" value="rtb-publica: 0.0.0.0/0 → IGW · 10.10/16 y 10.20/16 → VGW (propagación)&#xa;Dentro de la EC2: red Docker (frontend, backend, db, ...)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1095" y="772" width="389" height="33" as="geometry"/></mxCell><mxCell id="t43" value="Rutas estáticas: Juliaca 10.10.0.0/16 · Puno 10.20.0.0/16&#xa;AWS 10.50.0.0/16" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1095" y="825" width="320" height="33" as="geometry"/></mxCell><mxCell id="t44" value="Resumen de comunicación entre zonas (detalle: matriz Z01–Z30, sección 7.3)&#xa;PERMITE  Usuarios y clínica → EC2-ERP-01 443 · Gestión 10.10.70.50 → equipos (22/443/161)&#xa;PERMITE  DB-CONT-01 → EC2 22 (scp) por VPN · MON → EC2 9090 por VPN · Invitados → Internet&#xa;DENIEGA  Internet → LAN y subredes privadas · Usuarios → Gestión/Seguridad · Invitados → 10.0.0.0/8&#xa;DENIEGA  Cualquier VLAN → Clínica · Clínica → Internet general · DMZ → LAN y bases de datos&#xa;Política por defecto del firewall y de las ACL del núcleo: denegar todo y registrar" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="572" height="92" as="geometry"/></mxCell><mxCell id="title" value="Figura 5.2 — Topología lógica: VLAN, subredes, gateways y ruteo" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1F4E79;fontFamily=Arial;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>