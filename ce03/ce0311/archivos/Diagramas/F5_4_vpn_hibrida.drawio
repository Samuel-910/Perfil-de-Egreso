style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="290" height="80" as="geometry"/></mxCell><mxCell id="n9" value="rtb-publica (snet-publica-a)&#xa;10.10.0.0/16 y 10.20.0.0/16 → VGW&#xa;(propagación de rutas estáticas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#FF9900;fontFamily=Arial;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1110" y="590" width="290" height="76" as="geometry"/></mxCell><mxCell id="n10" value="EC2-ERP-01 10.50.0.10&#xa;SSH 22 · Prometheus 9090" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F4E79;fontFamily=Arial;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1110" y="750" width="290" height="60" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="VPN-JUL · 2 túneles" style="edgeStyle=none;html=1;strokeColor=#C55A11;strokeWidth=2.2;dashed=1;fontFamily=Arial;fontSize=10;fontColor=#C55A11;endArrow=block;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="VPN-JUL-B · fase 2 (BGP)" style="edgeStyle=none;html=1;strokeColor=#A6A6A6;strokeWidth=1.4;dashed=1;fontFamily=Arial;fontSize=10;fontColor=#A6A6A6;endArrow=block;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="VPN-PUN · 2 túneles" style="edgeStyle=none;html=1;strokeColor=#C55A11;strokeWidth=2.2;dashed=1;fontFamily=Arial;fontSize=10;fontColor=#C55A11;endArrow=block;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=none;html=1;strokeColor=#404040;strokeWidth=1.6;dashed=0;fontFamily=Arial;fontSize=10;fontColor=#404040;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t20" value="Parámetros (iguales en todos los túneles; secretos fuera del informe)&#xa;Fase 1: IKEv2 · AES-256 · SHA-256 · DH 14 mín. (20 preferido) · 28 800 s&#xa;Fase 2: ESP AES-256 · SHA-256 · PFS DH 14+ · 3 600 s&#xa;DPD 10 s (reinicio) · NAT-T UDP 4500 · rutas estáticas&#xa;Interior de cada túnel: /30 en 169.254.0.0/16 (asignado por AWS)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="444" height="82" as="geometry"/></mxCell><mxCell id="t21" value="* IP de documentación (RFC 5737); se reemplazan por las IP fijas contratadas.&#xa;Por la VPN: SSH, copia nocturna (scp), métricas 9090 y Wazuh. Los usuarios usan HTTPS.&#xa;Pruebas planeadas: C03, C04, C06, C07 y C17." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#262626;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="500" height="49" as="geometry"/></mxCell><mxCell id="title" value="Figura 5.4 — Topología VPN híbrida: extremos, IP públicas y rutas" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1F4E79;fontFamily=Arial;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>